# Multi-stage Dockerfile for building any API Sentinel service.
# Usage:
#   docker build -f infrastructure/docker/Dockerfile.service \
#     --build-arg SERVICE=contract-service -t apisentinel/contract-service .

FROM eclipse-temurin:21-jdk AS builder
ARG SERVICE
WORKDIR /workspace
COPY . .
RUN chmod +x ./gradlew && ./gradlew :apps:${SERVICE}:bootJar -x test

FROM eclipse-temurin:21-jre
ARG SERVICE
WORKDIR /app
COPY --from=builder /workspace/apps/${SERVICE}/build/libs/*.jar app.jar
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=70"
EXPOSE 8080
ENTRYPOINT ["sh","-c","exec java $JAVA_OPTS -jar /app/app.jar"]